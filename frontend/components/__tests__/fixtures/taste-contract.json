{
  "questions": {
    "version": "v1",
    "questions": [
      {
        "id": 1,
        "text": "새 게임을 켜면 가장 먼저 하는 일은?",
        "options": [
          {
            "key": "A",
            "text": "일단 미지의 장소로 떠나 본다"
          },
          {
            "key": "B",
            "text": "성장 시스템부터 확인한다"
          }
        ]
      },
      {
        "id": 2,
        "text": "더 기억에 남는 것은?",
        "options": [
          {
            "key": "A",
            "text": "NPC의 이야기"
          },
          {
            "key": "B",
            "text": "전략이 멋지게 들어맞은 순간"
          }
        ]
      },
      {
        "id": 3,
        "text": "어려운 보스를 만나면?",
        "options": [
          {
            "key": "A",
            "text": "될 때까지 반복해서 도전한다"
          },
          {
            "key": "B",
            "text": "일단 넘기고 다른 콘텐츠를 즐긴다"
          }
        ]
      },
      {
        "id": 4,
        "text": "어떤 환경에서 게임하는 게 좋아요?",
        "options": [
          {
            "key": "A",
            "text": "혼자서 푹 빠져서"
          },
          {
            "key": "B",
            "text": "친구와 함께"
          }
        ]
      },
      {
        "id": 5,
        "text": "어떤 보상이 더 짜릿해요?",
        "options": [
          {
            "key": "A",
            "text": "숨겨진 지역을 발견하는 것"
          },
          {
            "key": "B",
            "text": "강력한 장비를 얻는 것"
          }
        ]
      },
      {
        "id": 6,
        "text": "더 흥미로운 것은?",
        "options": [
          {
            "key": "A",
            "text": "캐릭터들의 관계"
          },
          {
            "key": "B",
            "text": "정교하게 짜인 게임 메커니즘"
          }
        ]
      },
      {
        "id": 7,
        "text": "게임에서 실패했을 때는?",
        "options": [
          {
            "key": "A",
            "text": "공략을 고쳐서 바로 재도전한다"
          },
          {
            "key": "B",
            "text": "여유롭게 다른 활동을 한다"
          }
        ]
      },
      {
        "id": 8,
        "text": "어떤 플레이를 더 좋아해요?",
        "options": [
          {
            "key": "A",
            "text": "싱글 캠페인"
          },
          {
            "key": "B",
            "text": "협동 플레이"
          }
        ]
      },
      {
        "id": 9,
        "text": "자유 시간이 생기면?",
        "options": [
          {
            "key": "A",
            "text": "새로운 지역을 탐사한다"
          },
          {
            "key": "B",
            "text": "기존 캐릭터를 강화한다"
          }
        ]
      },
      {
        "id": 10,
        "text": "게임에서 더 중요한 것은?",
        "options": [
          {
            "key": "A",
            "text": "흥미로운 선택과 결말"
          },
          {
            "key": "B",
            "text": "전략적인 최적화"
          }
        ]
      },
      {
        "id": 11,
        "text": "최고 난도 콘텐츠는?",
        "options": [
          {
            "key": "A",
            "text": "도전하고 싶다"
          },
          {
            "key": "B",
            "text": "부담 없이 즐기고 싶다"
          }
        ]
      },
      {
        "id": 12,
        "text": "게임 속 성취는?",
        "options": [
          {
            "key": "A",
            "text": "나만의 이야기를 완성하는 것"
          },
          {
            "key": "B",
            "text": "친구들과 함께 이룬 공동 성취"
          }
        ]
      }
    ]
  },
