{
  "name": "steam-game-recommend",
  "version": "1.0.0",
  "description": "Steam Game Recommendation App",
  "main": "main.js",
  "author": "Jeonggrius",
  "scripts": {
    "start": "electron .",
    "debug": "electron . --enable-logging --verbose",
    "build": "electron-builder",
    "build-win": "electron-builder --win",
    "dist": "electron-builder --publish=never",
    "copy-jar": "copy ..\\build\\libs\\recommend-0.0.1-SNAPSHOT.jar resources\\",
    "full-build": "npm run copy-jar && npm run dist",
    "clean": "rmdir /s /q dist node_modules\\.cache",
    "clean-db": "if exist resources\\data rmdir /s /q resources\\data",
    "fresh-build": "npm run clean-db && npm run copy-jar && npm run dist"
  },
  "build": {
    "appId": "com.steamgame.recommend",
    "productName": "Steam Game Recommend",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json",
      "resources/**/*",
      "!**/node_modules/**/*",
      "!dist",
      "!main-backup.js",
      "!resources/data/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*",
          "!data/**/*"
        ]
      }
    ],
    "win": {
      "target": {
        "target": "nsis",
        "arch": ["x64"]
      },
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "displayLanguageSelector": false,
      "installerLanguages": ["en"],
      "license": null,
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "publish": null
  },
  "devDependencies": {
    "electron": "28.2.0",
    "electron-builder": "24.13.3"
  },
  "dependencies": {
    "dotenv": "16.4.5"
  }
}